
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calgary Downtown Drive</title>
<style>
  body { margin:0; overflow:hidden; background:#87ceeb;
         font-family:Arial,sans-serif; }
  #hud {
    position:fixed; top:15px; left:15px; color:white;
    background:#0009; padding:14px; border-radius:10px;
    line-height:1.7; z-index:2;
  }
  #help {
    position:fixed; bottom:15px; left:50%;
    transform:translateX(-50%); color:white;
    background:#0009; padding:12px; border-radius:8px;
    text-align:center; white-space:nowrap;
  }
</style>
</head>
<body>
<div id="hud">
  <b>CALGARY DOWNTOWN</b><br>
  Speed: <span id="speed">0</span> km/h<br>
  Graphics: 3D
</div>
<div id="help">W / ↑ Accelerate · S / ↓ Brake · A D / ← → Steer</div>

<script type="module">
import * as THREE from
'https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js';

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87ceeb);
scene.fog = new THREE.Fog(0x87ceeb, 100, 650);

const camera = new THREE.PerspectiveCamera(
  65, innerWidth / innerHeight, 0.1, 1500
);
const renderer = new THREE.WebGLRenderer({ antialias:true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.15;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xcce8ff, 0x606050, 2));

const sun = new THREE.DirectionalLight(0xffedcf, 3);
sun.position.set(-80, 130, 60);
sun.castShadow = true;
sun.shadow.mapSize.set(2048,2048);
scene.add(sun);

function box(w,h,d,color,x,y,z, materialOptions={}) {
  const mesh = new THREE.Mesh(
    new THREE.BoxGeometry(w,h,d),
    new THREE.MeshStandardMaterial({
      color, roughness:0.75, ...materialOptions
    })
  );
  mesh.position.set(x,y,z);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  scene.add(mesh);
  return mesh;
}

// Ground
box(2000,1,2000,0x71866a,0,-1,0);

// Downtown street grid
const roadMat = new THREE.MeshStandardMaterial({
  color:0x30343a, roughness:0.92
});
function road(w,d,x,z) {
  const m = new THREE.Mesh(new THREE.PlaneGeometry(w,d),roadMat);
  m.rotation.x=-Math.PI/2;
  m.position.set(x,0.01,z);
  m.receiveShadow=true;
  scene.add(m);
}
for(let i=-500;i<=500;i+=100) {
  road(25,1100,i,0);
  road(1100,25,0,i);
}

// Road lane markings
const lineMat = new THREE.MeshBasicMaterial({color:0xe7e0bb});
for(let i=-500;i<=500;i+=100) {
  for(let z=-500;z<500;z+=15) {
    const mark=new THREE.Mesh(
      new THREE.BoxGeometry(0.22,0.025,6),lineMat);
    mark.position.set(i,0.035,z);
    scene.add(mark);
  }
  for(let x=-500;x<500;x+=15) {
    const mark=new THREE.Mesh(
      new THREE.BoxGeometry(6,0.025,0.22),lineMat);
    mark.position.set(x,0.035,i);
    scene.add(mark);
  }
}

// Calgary-style downtown buildings.
// Procedural buildings are illustrative, not exact real buildings.
let seed=12345;
function rand(){
  seed=(seed*1664525+1013904223)>>>0;
  return seed/4294967296;
}
const colors=[0x8296a5,0x9caaa9,0x596a7a,
              0xb4b2a6,0x687e8d,0xc2bcae];

for(let x=-450;x<=450;x+=50) {
 for(let z=-450;z<=450;z+=50) {
  if(Math.abs(x%100)<1 || Math.abs(z%100)<1) continue;
  const w=23+rand()*13, d=23+rand()*13;
  const h=18+Math.pow(rand(),2)*145;
  const b=box(w,h,d,colors[Math.floor(rand()*colors.length)],
              x+(rand()-.5)*7,h/2,z+(rand()-.5)*7);

  // Reflective-looking window facade
  const windows=new THREE.MeshStandardMaterial({
    color:0x426276, metalness:0.55, roughness:0.28
  });
  for(let yy=5;yy<h-3;yy+=5) {
    for(let xx=-w/2+3;xx<w/2-2;xx+=4) {
      box(0.12,1.8,0.12,0x263b49,
          b.position.x+xx,yy,b.position.z+d/2+0.08);
    }
  }
 }
}

// Player car
const car=new THREE.Group();
scene.add(car);

box(2.2,0.65,4.2,0xb51f29,0,0,0).parent.remove;
const body=new THREE.Mesh(
 new THREE.BoxGeometry(2.2,0.65,4.2),
 new THREE.MeshStandardMaterial({
   color:0xc51f2c,metalness:0.65,roughness:0.25
 })
);
body.position.y=0.8;
body.castShadow=true;
car.add(body);

const cabin=new THREE.Mesh(
 new THREE.BoxGeometry(1.65,0.7,2),
 new THREE.MeshStandardMaterial({
   color:0x294554,metalness:0.4,roughness:0.2
 })
);
cabin.position.set(0,1.42,-0.25);
car.add(cabin);

const wheels=[];
for(const x of [-1.08,1.08]) {
 for(const z of [-1.35,1.35]) {
  const wheel=new THREE.Mesh(
   new THREE.CylinderGeometry(0.39,0.39,0.24,24),
   new THREE.MeshStandardMaterial({color:0x151515,roughness:0.85})
  );
  wheel.rotation.z=Math.PI/2;
  wheel.position.set(x,0.42,z);
  car.add(wheel);
  wheels.push(wheel);
 }
}
car.position.set(0,0,12);

// Simple park trees
for(let i=0;i<100;i++) {
 const x=(rand()-.5)*900,z=(rand()-.5)*900;
 if(Math.abs(x%100)<20 || Math.abs(z%100)<20) continue;
 box(0.7,4,0.7,0x60462d,x,2,z);
 const crown=new THREE.Mesh(
   new THREE.SphereGeometry(2.6,10,8),
   new THREE.MeshStandardMaterial({color:0x397344})
 );
 crown.position.set(x,5,z);
 crown.castShadow=true;
 scene.add(crown);
}

// Controls
const keys={};
addEventListener('keydown',e=>keys[e.key.toLowerCase()]=true);
addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);

let speed=0, heading=0;
const clock=new THREE.Clock();
const speedDisplay=document.getElementById('speed');

function animate(){
 requestAnimationFrame(animate);
 const dt=Math.min(clock.getDelta(),0.04);

 if(keys.w||keys.arrowup) speed+=28*dt;
 else if(keys.s||keys.arrowdown) speed-=38*dt;
 else speed*=Math.pow(0.985,dt*60);

 speed=THREE.MathUtils.clamp(speed,-12,55);

 if(Math.abs(speed)>0.5) {
  if(keys.a||keys.arrowleft) heading+=1.7*dt*Math.sign(speed);
  if(keys.d||keys.arrowright) heading-=1.7*dt*Math.sign(speed);
 }

 car.rotation.y=heading;
 car.position.x+=Math.sin(heading)*speed*dt;
 car.position.z+=Math.cos(heading)*speed*dt;

 wheels.forEach(w=>w.rotation.x+=speed*dt/0.39);

 // Follow camera
 const behind=new THREE.Vector3(
  -Math.sin(heading)*10,5.5,-Math.cos(heading)*10
 );
 const target=car.position.clone().add(behind);
 camera.position.lerp(target,1-Math.exp(-4*dt));
 camera.lookAt(car.position.x,1.1,car.position.z);

 speedDisplay.textContent=Math.round(Math.abs(speed)*3.6);
 renderer.render(scene,camera);
}
animate();

addEventListener('resize',()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
